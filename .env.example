# Синтетическая симуляция без LLM включена по умолчанию. Файл .env сам по себе не загружается приложением.
# Экспортируйте переменные в окружение процесса Streamlit.
DVOINIK_MOCK=1
# local: вход по аккаунту; demo: общий отдельный демо-архив без LLM.
DVOINIK_AUTH_MODE=local
# DVOINIK_PORT=8501
# По умолчанию архив: .data/experiments.sqlite3 в папке проекта.
# Для постоянного тома или отдельного рабочего пространства задайте свой путь.
# DVOINIK_STORAGE_PATH=/path/to/experiments.sqlite3
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
# Кэш проверенных ответов LLM: повтор итерации с теми же текстами и профилями не тратит запросы.
# DVOINIK_LLM_CACHE=1
# DVOINIK_LLM_CACHE_PATH=/path/to/llm_cache.sqlite3
# Оценка запуска перед стартом: средняя задержка запроса и цена за 1000 токенов (необязательно).
# DVOINIK_LLM_LATENCY_S=3
# DVOINIK_PRICE_PER_1K_TOKENS=0.4
# DVOINIK_PRICE_CURRENCY=₽
# Способ получить готовность: probability (модель называет вероятность) или ssr —
# ответ фразой и оценка по смыслу через эмбеддинги (Maier et al., 2025).
# Рекомендуется ssr: на qwen3-30b-a3b-2507 только в нём двойники учитывали профиль.
DVOINIK_ELICITATION=ssr
LLM_EMBED_MODEL=bge-m3

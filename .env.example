# Синтетическая симуляция без LLM включена по умолчанию. Файл .env сам по себе не загружается приложением.
# Экспортируйте переменные в окружение процесса Streamlit.
DVOINIK_MOCK=1
# local: вход по аккаунту; demo: общий отдельный демо-архив без LLM.
DVOINIK_AUTH_MODE=local
# DVOINIK_PORT=8501
# По умолчанию архив: .data/experiments.sqlite3 в папке проекта.
# Для постоянного тома или отдельного рабочего пространства задайте свой путь.
# DVOINIK_STORAGE_PATH=/path/to/experiments.sqlite3
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama

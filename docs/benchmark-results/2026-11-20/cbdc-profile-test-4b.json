  "protocol": {
    "audience": "An online survey of adults in South Korea about a new digital currency issued by the central bank (CBDC). Around 51% women, 18% in Seoul, 62% married, 47% with a college degree. Age breakdown: 16% ages 19–29, 26% ages 30–45, 29% ages 46–59, 29% age 60+. Before CBDC is offered, for a private purchase in person about 39% choose cash, 34% card, 8% mobile, and the rest have no preference.",
    "designs": {
      "cr": "CBDC stores identity and transaction records together at one public institution, which may link them.",
      "sr": "CBDC stores identity and transaction records at separate public institutions so the records cannot readily be linked.",
      "voucher": "For small payments, a CBDC anonymity voucher leaves no personal or transaction record, including for AML/CFT checks."
    },
    "pcu": "Using CBDC can prevent financial firms and big technology companies from using your personal and transaction data commercially.",
    "question": "Imagine buying something private, such as a mental health service, and something ordinary, such as food. Consider both in-person and online purchases, weighing convenience and privacy. For each of sensitive_offline, sensitive_online, ordinary_offline, ordinary_online, the choices are cbdc (the central bank digital currency above), card (credit or debit), mobile (a fast mobile payment service), no_preference, and cash (in person only). Cash can generally be used without linking payment records to your identity; card and mobile payments leave linked records.",
    "systems": "You are a participant in this survey. Estimate the probability that you would choose CBDC in each setting.",
    "output_format": "Return a JSON object mapping the four settings to your personal probability of choosing cbdc, each a number from 0 to 1. A probability is not a yes/no answer.",
    "profiles": [
      "man; age 46–59; lives outside Seoul; not married; college degree or higher; had no preference in that preceding scenario",
      "woman; age 30–45; lives outside Seoul; married; college degree or higher; chose a debit or credit card in that preceding scenario",
